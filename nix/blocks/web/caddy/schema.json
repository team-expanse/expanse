{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Caddy's HTTP port (http_port). When exposed with EXPOSE_VIP, keep it different from the exposed port (80) and set it as target_port"
    },
    "httpsPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Caddy's HTTPS port (https_port), behind exposed port 443"
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s\"]+@[^@\\s\"]+$",
      "description": "ACME account email"
    },
    "acmeCA": {
      "type": "string",
      "pattern": "^https://[^\\s\"]+$",
      "description": "ACME directory URL; defaults to Let's Encrypt, then ZeroSSL"
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "description": "Sites served; each answers for one host name",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "type": "string",
            "pattern": "^(\\*\\.)?[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
            "description": "Host name the site answers for"
          },
          "tls": {
            "enum": [
              "acme",
              "internal",
              "off"
            ],
            "description": "acme (default): a public certificate; internal: Caddy's own CA; off: plain HTTP only"
          },
          "reverseProxy": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(https?://)?[A-Za-z0-9.-]+:[0-9]{1,5}$"
            },
            "description": "Upstreams as host:port, load-balanced round robin with passive health checks"
          },
          "respond": {
            "type": "string",
            "pattern": "^[^\\n\\r\"]*$",
            "description": "A fixed one-line body, for a placeholder or a health endpoint"
          }
        },
        "anyOf": [
          {
            "required": [
              "reverseProxy"
            ]
          },
          {
            "required": [
              "respond"
            ]
          }
        ],
        "if": {
          "required": [
            "respond"
          ]
        },
        "then": {
          "properties": {
            "reverseProxy": false
          }
        }
      }
    },
    "caddyfile": {
      "type": "string",
      "minLength": 1,
      "description": "A whole Caddyfile, used instead of sites; Caddy's data directory is still the block's volume"
    }
  },
  "anyOf": [
    {
      "required": [
        "sites"
      ]
    },
    {
      "required": [
        "caddyfile"
      ]
    }
  ],
  "if": {
    "required": [
      "caddyfile"
    ]
  },
  "then": {
    "properties": {
      "sites": false
    }
  }
}
