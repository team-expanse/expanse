{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "TCP port the metrics endpoint listens on"
    },
    "webTelemetryPath": {
      "type": "string",
      "minLength": 1,
      "description": "URL path for the metrics endpoint"
    }
  }
}
