{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "maxconn": {
      "type": "integer",
      "minimum": 1,
      "description": "Global connection limit"
    },
    "statsPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Port serving the stats page at /stats and Prometheus metrics at /metrics; unset, neither is served"
    },
    "frontends": {
      "type": "array",
      "minItems": 1,
      "description": "Listeners, each balancing over its own servers",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "port",
          "servers"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$",
            "description": "Frontend and backend name in stats and metrics"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Listen port. When exposed with EXPOSE_VIP, keep it different from the exposed port and set it as target_port"
          },
          "mode": {
            "enum": [
              "http",
              "tcp"
            ],
            "description": "http (default) adds X-Forwarded-For and HTTP health checks; tcp forwards bytes"
          },
          "balance": {
            "enum": [
              "roundrobin",
              "leastconn",
              "source",
              "first"
            ],
            "description": "Balancing algorithm (default roundrobin)"
          },
          "servers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$"
            },
            "description": "Servers as host:port"
          },
          "check": {
            "type": "boolean",
            "description": "Health-check servers every 2s and stop sending to failed ones (default true)"
          },
          "checkPath": {
            "type": "string",
            "pattern": "^/[^\\s\"]*$",
            "description": "HTTP mode: GET this path to check a server (default /); tcp mode checks the connection"
          }
        }
      }
    },
    "config": {
      "type": "string",
      "minLength": 1,
      "description": "A whole haproxy.cfg, used instead of frontends"
    }
  },
  "anyOf": [
    {
      "required": [
        "frontends"
      ]
    },
    {
      "required": [
        "config"
      ]
    }
  ],
  "if": {
    "required": [
      "config"
    ]
  },
  "then": {
    "properties": {
      "frontends": false
    }
  }
}
